# SwiftMint Environment Variables

# API Configuration
API_SECRET_KEY=your_secret_key_here
API_BASE_URL=http://localhost:3000

# Exchange Rate Source (optional - for future integration)
EXCHANGE_RATE_SOURCE=https://api.exchangerate-api.com
EXCHANGE_RATE_API_KEY=your_api_key_here

# Database Configuration (for future use)
DATABASE_URL=postgresql://user:password@localhost:5432/swiftmint
DATABASE_POOL_SIZE=10

# Authentication (for future implementation)
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=7d

# Feature Flags
ENABLE_MOCK_DATA=true
ENABLE_RATE_LIMITING=false

# Vercel Specific
VERCEL_URL=${VERCEL_URL}
VERCEL_ENV=${VERCEL_ENV}

# Payment Processing (for future integration)
STRIPE_PUBLIC_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key

# Monitoring & Analytics (optional)
SENTRY_DSN=your_sentry_dsn
GA_TRACKING_ID=your_google_analytics_id

# Email Service (for future notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_password

# Rate Limits (requests per minute)
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX_REQUESTS=100
