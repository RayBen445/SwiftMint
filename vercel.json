{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend/dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/send",
      "dest": "/api/send.ts"
    },
    {
      "src": "/api/receive",
      "dest": "/api/receive.ts"
    },
    {
      "src": "/api/convert",
      "dest": "/api/convert.ts"
    },
    {
      "src": "/api/rates",
      "dest": "/api/rates.ts"
    },
    {
      "src": "/api/transactions",
      "dest": "/api/transactions.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/index.html"
    }
  ]
}
